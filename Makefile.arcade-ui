# PCSX ReArcade's selector on macOS (tools/arcade-ui/arcade_ui_mac.cpp):
# arcade-shelf (deps/arcade-shelf) with the System 12 sets of a rompath, to
# preview it without a Vita. Needs SDL3 and libpng (Homebrew).
#   make -f Makefile.arcade-ui
#   build/arcade-ui/arcade-ui --demo
# ADB=1 adds the artwork download from Arcade Database (needs the site
# author's agreement before release; see deps/arcade-shelf/src/adb_scraper.h).
CC := xcrun clang
CXX := xcrun clang++
ADB ?= 0
SHELF := deps/arcade-shelf
SHELF_LIB := $(SHELF)/build$(if $(filter 1,$(ADB)),-adb,)/libarcadeshelf.a
BUILD := build/arcade-ui$(if $(filter 1,$(ADB)),-adb,)
TARGET := $(BUILD)/arcade-ui
SDL3_CFLAGS := $(shell pkg-config --cflags sdl3)
SDL3_LIBS := $(shell pkg-config --libs sdl3)
LIBPNG_CFLAGS := $(shell pkg-config --cflags libpng)
LIBPNG_LIBS := $(shell pkg-config --libs libpng)
CFLAGS := -arch arm64 -O2 -g -Wall -Iinclude -I$(SHELF)/include $(SDL3_CFLAGS) $(LIBPNG_CFLAGS)
CXXFLAGS := $(CFLAGS) -std=gnu++17
SOURCES_CXX := tools/arcade-ui/arcade_ui_mac.cpp frontend/arcade_catalog.cpp frontend/shelf_options.cpp
SOURCES_C := libpcsxcore/arcade/system12_romset.c libpcsxcore/arcade/arcade_romset.c libpcsxcore/arcade/mame_zip.c \
	libpcsxcore/arcade/mame_romindex.c libpcsxcore/arcade/mame_romload.c
OBJECTS := $(addprefix $(BUILD)/,$(SOURCES_CXX:.cpp=.o) $(SOURCES_C:.c=.o))

.PHONY: all clean FORCE
all: $(TARGET)

$(TARGET): $(OBJECTS) $(SHELF_LIB)
	$(CXX) -arch arm64 -o $@ $^ $(SDL3_LIBS) $(LIBPNG_LIBS) $(if $(filter 1,$(ADB)),-lcurl,) -lz -framework OpenGL

# arcade-shelf has its own makefile; it rebuilds only what changed.
$(SHELF_LIB): FORCE
	$(MAKE) -C $(SHELF) ADB=$(ADB) $(patsubst $(SHELF)/%,%,$(SHELF_LIB))

$(BUILD)/%.o: %.cpp Makefile.arcade-ui
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/%.o: %.c Makefile.arcade-ui
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -std=gnu99 -MMD -MP -c $< -o $@

clean:
	rm -rf build/arcade-ui build/arcade-ui-adb
	$(MAKE) -C $(SHELF) clean

-include $(OBJECTS:.o=.d)
