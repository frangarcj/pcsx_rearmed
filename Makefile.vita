VITA_GPU ?= vitagl
ARCADE_SYSTEM12 ?= 0
SYSTEM12_PROFILE ?= 0
VITA_CTR_GPU_TRACE ?= 0
# The NEON renderer uses its ARMv7 assembly (console and arcade VRAM);
# VITA_GPU_NEON_C=1 selects the C renderer for comparisons.
VITA_GPU_NEON_C ?= 0
VITAGL_DIR ?= build/vita-deps/vitaGL
# GPU profiler captures (psp2-cex-gpues4-prof, vitaGL only): the eboot then
# imports psp2_gpuprof.skprx and needs it loaded before it starts.
VITA_GPUPROF ?= 0
GPUPROF_PREFIX ?= $(HOME)/Fun/psp2-cex-gpues4-prof/install
ifeq ($(VITA_GPU),neon)
BUILTIN_VITA_GPU := neon
DEFAULT_TITLE_ID := PCSXN0012
else ifeq ($(VITA_GPU),vitagl)
BUILTIN_VITA_GPU := vita_ctr
CFLAGS_GPU := -DSTANDALONE_VITAGL
DEFAULT_TITLE_ID := PCSXG0012
else
$(error VITA_GPU must be neon or vitagl)
endif
# The arcade build selects games on arcade-shelf (deps/arcade-shelf): MAME
# sets as cabinets, PlayStation discs as discs. It shares VitaSDK's ImGui
# with the pause menu. It is the PCSX ReArcade app: its own title ID, name
# and data folder (ux0:data/pcsx-rearcade, frontend/vita/app_root.h); the
# other builds keep the validation IDs and ux0:data/pcsx-rearmed.
ARCADE_SHELF ?= $(if $(filter vitagl,$(VITA_GPU)),$(ARCADE_SYSTEM12),0)
# PCSX ReArcade's second executable, eboot_neon.bin: the NEON renderer for
# the games the selector hands it (Renderer = NEON), with the same pause
# menu, presented through vitaGL. The app's VPK builds and packs it.
REARCADE_NEON ?= 0
REARCADE := $(if $(filter 1,$(ARCADE_SHELF) $(REARCADE_NEON)),1,0)
# gpulib's GPU worker thread (--gpu-thread): with NEON it rasterizes, with
# vitaGL it builds the frame packets (the renderer thread draws them). The
# app's menu mode turns it on.
VITA_GPU_THREAD ?= $(REARCADE)
ifeq ($(REARCADE_NEON),1)
ifneq ($(VITA_GPU)$(ARCADE_SYSTEM12)$(ARCADE_SHELF),neon10)
$(error REARCADE_NEON=1 requires VITA_GPU=neon and ARCADE_SYSTEM12=1)
endif
TARGET ?= pcsx-rearcade-neon
else ifeq ($(ARCADE_SHELF),1)
TARGET ?= pcsx-rearcade$(if $(filter 1,$(SYSTEM12_PROFILE)),-profile,)
TITLE_ID ?= PCRA00001
TITLE ?= PCSX ReArcade
else
TARGET ?= pcsx-rearmed-vita-$(VITA_GPU)$(if $(filter 1,$(SYSTEM12_PROFILE)),-profile,)
TITLE_ID ?= $(DEFAULT_TITLE_ID)
TITLE ?= PCSX-ReARMed Vita $(VITA_GPU)
endif
CORE_NAME := pcsx_rearmed_$(VITA_GPU)$(if $(filter 1,$(ARCADE_SYSTEM12)),_system12,)$(if $(filter 1,$(SYSTEM12_PROFILE)),_profile,)$(if $(filter 1,$(REARCADE)),_rearcade,)
CORE := $(CORE_NAME)_libretro_vita.a
SMOKE_EXE ?=
PACK_EXTRA := $(if $(SMOKE_EXE),-a $(SMOKE_EXE)=smoke.exe,)
# PCSX ReArcade's LiveArea icon: an arcade-shelf cabinet, 128x128 8-bit.
PACK_EXTRA += $(if $(filter 1,$(ARCADE_SHELF)),-a frontend/vita/sce_sys/icon0.png=sce_sys/icon0.png,)
GIT_VERSION := $(shell git rev-parse --short HEAD)

PREFIX := arm-vita-eabi-
CC := $(PREFIX)gcc
CXX := $(PREFIX)g++
CFLAGS := -O3 -g -Wall -Wextra -DVITA -mcpu=cortex-a9 -mtune=cortex-a9 -mfpu=neon -marm \
	-fsingle-precision-constant -mword-relocations -ffast-math -fno-unwind-tables \
	-fno-asynchronous-unwind-tables -I$(VITASDK)/include -Ideps/libretro-common/include -I$(VITAGL_DIR)/source
# Room after the code segment for vita-elf-create's SCE data: VitaSDK's
# linker script (2026.08 on) otherwise lets the data segment start too close
# ("Cannot allocate ... SCE data at end of segment 0; segment 1 overlaps").
# Older linker scripts ignore the symbol.
LDFLAGS := -Wl,-q -Wl,--defsym=__sce_headroom=0x10000
VITAGL_LINK := $(VITAGL_DIR)/libvitaGL.a
LIBS = -lSDL3 -lvita2d $(VITAGL_LINK) -lvitashark -lSceShaccCgExt -ltaihen_stub -lSceShaccCg_stub \
	-lSceKernelDmacMgr_stub -lpthread -lc -lSceCommonDialog_stub -lSceAudio_stub \
	-lSceLibKernel_stub -lmathneon -lkubridge_stub -lSceNet_stub -lSceNetCtl_stub \
	-lpng -lSceDisplay_stub -lSceGxm_stub -lSceAudioIn_stub \
	-Wl,--whole-archive -lSceSysmodule_stub -Wl,--no-whole-archive -lSceIme_stub \
	-lSceCamera_stub -lSceCtrl_stub -lSceTouch_stub -lSceMotion_stub -lm \
	-lSceAppMgr_stub -lSceHid_stub -lSceAppUtil_stub -lScePgf_stub -ljpeg \
	-lSceRtc_stub -lScePower_stub -lSceIofilemgr_stub -lcurl -lssl -lcrypto -lz
CFLAGS += $(CFLAGS_GPU)
ifeq ($(VITA_GPU_THREAD),1)
CFLAGS += -DUSE_ASYNC_GPU
endif
GPUPROF_OBJ :=
ifeq ($(VITA_GPUPROF),1)
ifneq ($(VITA_GPU),vitagl)
$(error VITA_GPUPROF=1 requires VITA_GPU=vitagl)
endif
CFLAGS += -DVITA_GPUPROF -I$(GPUPROF_PREFIX)/include
GPUPROF_WRAPS := glCreateProgram glDeleteProgram glUseProgram glDrawArrays glDrawElements \
	glDrawRangeElements glDrawArraysInstanced glDrawElementsInstanced glDrawElementsBaseVertex \
	glDrawRangeElementsBaseVertex vglSwapBuffers sceGxmBeginScene sceGxmEndScene sceGxmMidSceneFlush \
	sceGxmDraw sceGxmDrawInstanced sceGxmDrawPrecomputed sceGxmSetVertexProgram sceGxmSetFragmentProgram \
	sceGxmCreateContext sceGxmDestroyContext sceGxmShaderPatcherCreateVertexProgram \
	sceGxmShaderPatcherCreateFragmentProgram sceGxmShaderPatcherAddRefVertexProgram \
	sceGxmShaderPatcherAddRefFragmentProgram sceGxmShaderPatcherReleaseVertexProgram \
	sceGxmShaderPatcherReleaseFragmentProgram sceGxmShaderPatcherDestroy sceGxmDisplayQueueAddEntry \
	sceGxmTransferCopy sceGxmTransferFill sceGxmTransferDownscale sceGxmTransferFinish \
	sceGxmSetFrontFragmentProgramEnable sceGxmSetBackFragmentProgramEnable \
	sceGxmShaderPatcherCreateMaskUpdateFragmentProgram
LDFLAGS += $(foreach f,$(GPUPROF_WRAPS),-Wl,--wrap=$(f))
VITAGL_LINK := -Wl,--start-group $(VITAGL_DIR)/libvitaGL.a $(GPUPROF_PREFIX)/lib/libpsp2_gpuprof_vitagl.a \
	$(GPUPROF_PREFIX)/lib/libpsp2_gpuprof_gxm_observer.a $(GPUPROF_PREFIX)/lib/libpsp2_gpuprof_client.a \
	$(GPUPROF_PREFIX)/lib/libpsp2_gpuprof_stub.a -Wl,--end-group -lSceKernelThreadMgr_stub
endif
ifeq ($(ARCADE_SYSTEM12),1)
CFLAGS += -DARCADE_SYSTEM12
endif
ifeq ($(SYSTEM12_PROFILE),1)
CFLAGS += -DPCSX_SYSTEM12_PROFILE
endif
BUILD_DIR := build-vita/$(VITA_GPU)$(if $(filter 1,$(ARCADE_SYSTEM12)),-system12,)$(if $(filter 1,$(SYSTEM12_PROFILE)),-profile,)$(if $(filter 1,$(REARCADE)),-rearcade,)
STANDALONE_OBJ := $(BUILD_DIR)/standalone.o
ifeq ($(VITA_GPUPROF),1)
GPUPROF_OBJ := $(BUILD_DIR)/vita_gpuprof.o
endif
# The vitaGL build has the menu UI: ROM selector, pause menu, options and
# save states (ImGui on the renderer's GL context).
UI_OBJS :=
UI_LIBS :=
ifeq ($(VITA_GPU),vitagl)
UI_OBJS := $(BUILD_DIR)/rom_selector.o $(BUILD_DIR)/settings.o $(BUILD_DIR)/savestates.o
UI_LIBS := -limgui
endif
SHELF_DIR := deps/arcade-shelf
SHELF_LIB := $(SHELF_DIR)/build-vita-sysimgui/libarcadeshelf.a
ifeq ($(ARCADE_SHELF),1)
ifneq ($(VITA_GPU)$(ARCADE_SYSTEM12),vitagl1)
$(error ARCADE_SHELF=1 requires VITA_GPU=vitagl and ARCADE_SYSTEM12=1)
endif
CFLAGS += -DARCADE_SHELF
UI_OBJS += $(BUILD_DIR)/shelf_selector.o
NEON_EBOOT := build-vita/neon-system12-rearcade/eboot.bin
PACK_EXTRA += -a $(NEON_EBOOT)=eboot_neon.bin
endif
ifeq ($(REARCADE_NEON),1)
CFLAGS += -DREARCADE_NEON
UI_OBJS := $(BUILD_DIR)/settings.o $(BUILD_DIR)/savestates.o $(BUILD_DIR)/gl_present.o
UI_LIBS := -limgui
endif
# Screenshots on request for hardware debugging (frontend/vita/shelf_common.h).
VITA_DEBUG_SHOT ?= 0
# Release builds (RELEASE=1, the published VPKs): no debugging aids, and the
# app does not keep the console awake while a game runs.
RELEASE ?= 0
ifeq ($(RELEASE),1)
ifeq ($(VITA_DEBUG_SHOT),1)
$(error RELEASE=1 excludes VITA_DEBUG_SHOT=1)
endif
CFLAGS += -DPCSX_RELEASE
endif
ifeq ($(REARCADE)$(VITA_DEBUG_SHOT),11)
CFLAGS += -DVITA_DEBUG_SHOT
endif
ifeq ($(REARCADE),1)
CFLAGS += -DPCSX_REARCADE -DPCSX_GIT_VERSION='"$(GIT_VERSION)"' -I$(SHELF_DIR)/include
UI_OBJS += $(BUILD_DIR)/shelf_common.o $(BUILD_DIR)/shelf_pause.o $(BUILD_DIR)/arcade_catalog.o \
	$(BUILD_DIR)/shelf_options.o $(BUILD_DIR)/shelf_snapshot.o
UI_LIBS := $(SHELF_LIB) $(UI_LIBS)
endif
CORE_ARGS := platform=vita PCSX_REARCADE=$(REARCADE) ARCADE_SYSTEM12=$(ARCADE_SYSTEM12) SYSTEM12_PROFILE=$(SYSTEM12_PROFILE) VITA_CTR_GPU_TRACE=$(VITA_CTR_GPU_TRACE) TARGET_NAME=$(CORE_NAME) BUILTIN_GPU=$(BUILTIN_VITA_GPU) GPU_NEON_USE_C=$(VITA_GPU_NEON_C) VITAGL_DIR=$(VITAGL_DIR) GIT_VERSION=$(GIT_VERSION) USE_LIBRETRO_VFS=0 \
	USE_ASYNC_CDROM=0 USE_ASYNC_GPU=$(VITA_GPU_THREAD) USE_ASYNC_SPU=0 \
	EXTRA_EXTERN_SYMS='_newlib_vm_size_user $(if $(filter 1,$(REARCADE)),system12_romset_count system12_romset_at system12_romset_scan,) pcsx_vita_uses_dynarec pcsx_vita_read_smoke pcsx_vita_read_system12_drc pcsx_vita_write_system12_report pcsx_raw_frame_cb pcsx_vita_swap_cb pcsx_vita_gpu_label_cb pcsxr_gpu2_core pcsxr_gpu_core pcsxr_board_core gte_widescreen_ops system12_board_wait_us system12_board_wait_n system12_perf_timing system12_c352_access_us system12_c352_horizon_us system12_c352_accesses system12_board_busy_us system12_board_cpu_us system12_h8_us system12_pcm_us system12_h8_instructions system12_h8_shared $(if $(filter 1,$(VITA_GPU_THREAD)),gpu_async_wait_us gpu_async_wait_n gpu_async_perf_timing gpu_async_busy_us gpu_async_words gpu_async_waits_by gpu_async_wait_us_by gpu_async_write_last,) $(if $(filter vitagl,$(VITA_GPU)),pcsx_vita_gl_capture_request pcsx_vita_gl_capture_store pcsx_vita_gl_hd pcsx_vita_gl_msaa pcsx_vita_ctr_wait_us pcsx_vita_ctr_wait_n NativeGpu_InitBackend NativeGpu_RunBackendTaskSync VitaCtrNativeRenderer_PresentCurrentFrame VitaCtrNativeRenderer_SetAspectMode VitaCtrNativeRenderer_GetFrameViewport pcsx_vita_ctr_task_fn pcsx_vita_ctr_task_n pcsx_vita_ctr_task_us pcsx_vita_ctr_read_rect pcsx_vita_ctr_read_n pcsx_menu_backdrop_request NativeRenderer_SwapWindow gpu_sync_renderer,) $(if $(filter 1,$(SYSTEM12_PROFILE)),pcsx_profile_begin pcsx_profile_end pcsx_profile_log,)'

.PHONY: all core clean vita-gl neon-eboot FORCE
all: $(TARGET).vpk

vita-gl:
	python3 tools/vita-harness/build_vitagl.py --output $(VITAGL_DIR)

core: vita-gl
	$(MAKE) -B -f Makefile.libretro $(CORE_ARGS) -j4

$(BUILD_DIR):
	mkdir -p $@

# The frontend objects follow the flags as well as the sources: the same
# BUILD_DIR serves builds with and without VITA_DEBUG_SHOT, RELEASE, etc.
FLAGS_STAMP := $(BUILD_DIR)/compile-flags.txt
$(FLAGS_STAMP): FORCE
	@mkdir -p $(BUILD_DIR)
	@printf '%s\n' '$(CC) $(CXX) $(CFLAGS)' > $@.tmp
	@cmp -s $@.tmp $@ || cp $@.tmp $@
	@rm -f $@.tmp

$(STANDALONE_OBJ): frontend/vita/standalone.c frontend/vita/validation.h frontend/vita/input_csv_reader.h Makefile.vita $(FLAGS_STAMP) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD_DIR)/rom_selector.o: frontend/vita/rom_selector.cpp Makefile.vita $(FLAGS_STAMP) | $(BUILD_DIR)
	$(CXX) $(CFLAGS) -std=gnu++11 -MMD -MP -c $< -o $@

$(BUILD_DIR)/shelf_selector.o $(BUILD_DIR)/shelf_common.o $(BUILD_DIR)/shelf_pause.o: $(BUILD_DIR)/%.o: frontend/vita/%.cpp Makefile.vita $(FLAGS_STAMP) | $(BUILD_DIR)
	$(CXX) $(CFLAGS) -std=gnu++11 -MMD -MP -c $< -o $@

$(BUILD_DIR)/arcade_catalog.o $(BUILD_DIR)/shelf_options.o $(BUILD_DIR)/shelf_snapshot.o: $(BUILD_DIR)/%.o: frontend/%.cpp Makefile.vita $(FLAGS_STAMP) | $(BUILD_DIR)
	$(CXX) $(CFLAGS) -std=gnu++11 -MMD -MP -c $< -o $@

# arcade-shelf has its own makefile; it rebuilds only what changed.
$(SHELF_LIB): FORCE
	$(MAKE) -C $(SHELF_DIR) vita IMGUI=system VITAGL_DIR=$(abspath $(VITAGL_DIR))

$(BUILD_DIR)/%.o: frontend/vita/%.c Makefile.vita $(FLAGS_STAMP) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(GPUPROF_OBJ): frontend/vita/vita_gpuprof.c frontend/vita/vita_gpuprof.h Makefile.vita $(FLAGS_STAMP) | $(BUILD_DIR)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(TARGET).elf: core $(STANDALONE_OBJ) $(GPUPROF_OBJ) $(UI_OBJS) $(if $(filter 1,$(REARCADE)),$(SHELF_LIB),)
	$(CXX) $(CFLAGS) $(LDFLAGS) $(STANDALONE_OBJ) $(GPUPROF_OBJ) $(UI_OBJS) $(CORE) $(UI_LIBS) $(LIBS) -o $@

$(TARGET).velf: $(TARGET).elf
	vita-elf-create $< $@

# The NEON executable for the app's VPK (its core is built in the tree too,
# so after this one's, never at the same time).
neon-eboot: $(TARGET).velf
	vita-make-fself -c -s -na $< $(BUILD_DIR)/eboot.bin

ifeq ($(ARCADE_SHELF),1)
$(NEON_EBOOT): $(TARGET).velf FORCE
	$(MAKE) -f Makefile.vita VITA_GPU=neon ARCADE_SYSTEM12=1 ARCADE_SHELF=0 REARCADE_NEON=1 \
		VITAGL_DIR=$(VITAGL_DIR) neon-eboot
endif

$(TARGET).vpk: $(TARGET).velf $(NEON_EBOOT)
	vita-make-fself -c -s -na $< $(BUILD_DIR)/eboot.bin
	vita-mksfoex -s TITLE_ID=$(TITLE_ID) -d ATTRIBUTE2=12 "$(TITLE)" $(BUILD_DIR)/param.sfo
	vita-pack-vpk -s $(BUILD_DIR)/param.sfo -b $(BUILD_DIR)/eboot.bin $(PACK_EXTRA) $@

clean:
	$(MAKE) -f Makefile.libretro $(CORE_ARGS) clean || true
	rm -rf $(BUILD_DIR) $(TARGET).elf $(TARGET).velf $(TARGET).vpk eboot.bin param.sfo

-include $(STANDALONE_OBJ:.o=.d) $(UI_OBJS:.o=.d)
