CXX ?= clang++
CXXFLAGS ?= -std=c++11 -O2 -g -Wall -Wextra -Werror
BUILD ?= build/h8-tests
PERIPHERALS := libpcsxcore/arcade/h8_cycle_clock.cpp libpcsxcore/arcade/h8_adc.cpp libpcsxcore/arcade/h8_sci.cpp libpcsxcore/arcade/h8_timer16.cpp
PERIPHERAL_HEADERS := $(PERIPHERALS:.cpp=.h)
TARGET := $(BUILD)/h8-standalone
TIMESTAMP_TARGET := $(BUILD)/h8-timestamp
SOFT_RESET_TARGET := $(BUILD)/h8-soft-reset
.PHONY: all test spin-skip-test spin-skip-ubsan-test irq-test rom-test deadline-test deadline-ubsan-test cycle-clock-test cycle-clock-ubsan-test sci-sync-timer-test sci-sync-timer-ubsan-test clean
all: $(TARGET)
$(TARGET): libpcsxcore/arcade/h8.cpp $(PERIPHERALS) $(PERIPHERAL_HEADERS) libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_dispatch.inc libpcsxcore/arcade/h8_fast.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_standalone.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_standalone.cpp -o $@
$(TIMESTAMP_TARGET): libpcsxcore/arcade/h8.cpp $(PERIPHERALS) $(PERIPHERAL_HEADERS) libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_dispatch.inc libpcsxcore/arcade/h8_fast.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_timestamp.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_timestamp.cpp -o $@
$(SOFT_RESET_TARGET): libpcsxcore/arcade/h8.cpp $(PERIPHERALS) $(PERIPHERAL_HEADERS) libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_dispatch.inc libpcsxcore/arcade/h8_fast.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_soft_reset.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_soft_reset.cpp -o $@
DEADLINE_TARGET := $(BUILD)/h8-deadline
$(DEADLINE_TARGET): libpcsxcore/arcade/h8.cpp $(PERIPHERALS) $(PERIPHERAL_HEADERS) libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_dispatch.inc libpcsxcore/arcade/h8_fast.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_deadline.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_deadline.cpp -o $@
CYCLE_CLOCK_TARGET := $(BUILD)/h8-cycle-clock
$(CYCLE_CLOCK_TARGET): libpcsxcore/arcade/h8_cycle_clock.cpp libpcsxcore/arcade/h8_cycle_clock.h tests/h8_cycle_clock.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) libpcsxcore/arcade/h8_cycle_clock.cpp tests/h8_cycle_clock.cpp -o $@
cycle-clock-test: $(CYCLE_CLOCK_TARGET)
	$(CYCLE_CLOCK_TARGET)
SCI_SYNC_TIMER_TARGET := $(BUILD)/h8-sci-sync-timer
$(SCI_SYNC_TIMER_TARGET): libpcsxcore/arcade/h8.cpp $(PERIPHERALS) $(PERIPHERAL_HEADERS) libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_dispatch.inc libpcsxcore/arcade/h8_fast.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_sci_sync_timer.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_sci_sync_timer.cpp -o $@
sci-sync-timer-test: $(SCI_SYNC_TIMER_TARGET)
	$(SCI_SYNC_TIMER_TARGET)
SPIN_SKIP_TARGET := $(BUILD)/h8-spin-skip
$(SPIN_SKIP_TARGET): libpcsxcore/arcade/h8.cpp $(PERIPHERALS) $(PERIPHERAL_HEADERS) libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_dispatch.inc libpcsxcore/arcade/h8_fast.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_spin_skip.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_spin_skip.cpp -o $@
spin-skip-test: $(SPIN_SKIP_TARGET)
	$(SPIN_SKIP_TARGET)
spin-skip-ubsan-test:
	@mkdir -p $(BUILD)/ubsan
	$(CXX) -std=c++11 -O1 -g -Wall -Wextra -Werror -fsanitize=undefined -fno-sanitize-recover=all libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_spin_skip.cpp -o $(BUILD)/ubsan/h8-spin-skip
	$(BUILD)/ubsan/h8-spin-skip
test: $(TARGET) $(TIMESTAMP_TARGET) $(SOFT_RESET_TARGET) $(DEADLINE_TARGET) $(CYCLE_CLOCK_TARGET) $(SCI_SYNC_TIMER_TARGET) $(SPIN_SKIP_TARGET)
	$(SPIN_SKIP_TARGET)
	$(TARGET)
	$(TIMESTAMP_TARGET)
	$(SOFT_RESET_TARGET)
	$(DEADLINE_TARGET)
	$(CYCLE_CLOCK_TARGET)
	$(SCI_SYNC_TIMER_TARGET)
IRQ_TARGET := $(BUILD)/h8-irq-filter
$(IRQ_TARGET): libpcsxcore/arcade/h8.cpp $(PERIPHERALS) $(PERIPHERAL_HEADERS) libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_dispatch.inc libpcsxcore/arcade/h8_fast.inc libpcsxcore/arcade/h8_arithmetic.inc tests/h8_irq_filter.cpp
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) tests/h8_irq_filter.cpp $(PERIPHERALS) -o $@
irq-test: $(IRQ_TARGET)
	$(IRQ_TARGET)
deadline-test: $(DEADLINE_TARGET)
	$(DEADLINE_TARGET)
SAN_DIR := $(BUILD)/ubsan
SAN_FLAGS := -std=c++11 -O1 -g -Wall -Wextra -Werror -fsanitize=undefined -fno-sanitize-recover=all
deadline-ubsan-test:
	@mkdir -p $(SAN_DIR)
	$(CXX) $(SAN_FLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_timestamp.cpp -o $(SAN_DIR)/h8-timestamp
	$(CXX) $(SAN_FLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_soft_reset.cpp -o $(SAN_DIR)/h8-soft-reset
	$(CXX) $(SAN_FLAGS) tests/h8_irq_filter.cpp $(PERIPHERALS) -o $(SAN_DIR)/h8-irq-filter
	$(CXX) $(SAN_FLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_deadline.cpp -o $(SAN_DIR)/h8-deadline
	$(SAN_DIR)/h8-timestamp
	$(SAN_DIR)/h8-soft-reset
	$(SAN_DIR)/h8-irq-filter
	$(SAN_DIR)/h8-deadline
cycle-clock-ubsan-test:
	@mkdir -p $(SAN_DIR)
	$(CXX) $(SAN_FLAGS) libpcsxcore/arcade/h8_cycle_clock.cpp tests/h8_cycle_clock.cpp -o $(SAN_DIR)/h8-cycle-clock
	$(SAN_DIR)/h8-cycle-clock
sci-sync-timer-ubsan-test:
	@mkdir -p $(SAN_DIR)
	$(CXX) $(SAN_FLAGS) libpcsxcore/arcade/h8.cpp $(PERIPHERALS) tests/h8_sci_sync_timer.cpp -o $(SAN_DIR)/h8-sci-sync-timer
	$(SAN_DIR)/h8-sci-sync-timer
SYNC_FIXTURE_TARGET := $(BUILD)/h8-sync-timer-fixture
$(SYNC_FIXTURE_TARGET): tests/h8_sync_timer_fixture.cpp libpcsxcore/arcade/h8.cpp $(PERIPHERALS) $(PERIPHERAL_HEADERS) libpcsxcore/arcade/h8.h libpcsxcore/arcade/h8_instructions.inc libpcsxcore/arcade/h8_dispatch.inc libpcsxcore/arcade/h8_fast.inc libpcsxcore/arcade/h8_arithmetic.inc
	@mkdir -p $(BUILD)
	$(CXX) $(CXXFLAGS) tests/h8_sync_timer_fixture.cpp $(PERIPHERALS) -o $@
.PHONY: sci-sync-timer-fixture
sci-sync-timer-fixture: $(SYNC_FIXTURE_TARGET)
rom-test: $(TARGET)
	$(TARGET) artifacts/system12/sub.bin 120
clean:
	rm -rf $(BUILD)
