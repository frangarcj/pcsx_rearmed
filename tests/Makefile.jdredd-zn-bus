CXX ?= c++
CC ?= cc
BUILD ?= build/jdredd-zn-bus-tests
ARCADE := libpcsxcore/arcade
ATA_PORT := $(ARCADE)/ata_mame
INCLUDES := -I$(ARCADE) -I$(ATA_PORT)
COMMON := -std=c++20 -Wall -Wextra -Werror $(INCLUDES)
SOURCES := $(ARCADE)/ata_storage.cpp $(ATA_PORT)/atahle_port.cpp $(ATA_PORT)/atastorage_port.cpp $(ARCADE)/gnet_pccard.cpp $(ARCADE)/rf5c296.cpp tests/jdredd_zn_bus_standalone.cpp
HEADERS := $(ARCADE)/jdredd_zn_bus.h $(ARCADE)/ata_storage.h $(ATA_PORT)/ata_mame_compat.h
SAN := -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer
.PHONY: test sanitize
$(BUILD)/via.o: $(ARCADE)/jdredd_zn_bus.c $(HEADERS)
	@mkdir -p $(BUILD)
	$(CC) -std=c99 -Wall -Wextra -Werror $(INCLUDES) -O2 -c $< -o $@
$(BUILD)/via-san.o: $(ARCADE)/jdredd_zn_bus.c $(HEADERS)
	@mkdir -p $(BUILD)
	$(CC) -std=c99 -Wall -Wextra -Werror $(INCLUDES) $(SAN) -c $< -o $@
$(BUILD)/test-jdredd-zn-bus: $(SOURCES) $(HEADERS) $(BUILD)/via.o
	$(CXX) $(COMMON) -O2 $(SOURCES) $(BUILD)/via.o -o $@
$(BUILD)/test-jdredd-zn-bus-sanitize: $(SOURCES) $(HEADERS) $(BUILD)/via-san.o
	$(CXX) $(COMMON) $(SAN) $(SOURCES) $(BUILD)/via-san.o -o $@
test: $(BUILD)/test-jdredd-zn-bus
	$<
sanitize: $(BUILD)/test-jdredd-zn-bus-sanitize
	ASAN_OPTIONS=halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 $<
