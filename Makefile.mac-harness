# Native Apple Silicon headless core + GPU_NEON; does not use config.mak.
CC := xcrun clang
.DEFAULT_GOAL := all
CXX := xcrun clang++
GPU ?= neon
ifeq ($(GPU),vitagl-like)
BUILD ?= build/mac-harness-vitagl-like
else
BUILD ?= build/mac-harness
endif
TARGET := $(BUILD)/pcsx-harness
BOARD ?= 1
HAVE_CHD ?= 1
SYSTEM12_TIMING ?= 0
ARCADE_TIMING ?= 1
DRC ?= 0
CFLAGS := -arch arm64 -O2 -g -std=gnu99 -Wall -Wno-unknown-pragmas \
  -I$(BUILD) -Iinclude -Ifrontend -include stdio.h \
  -DTEXTURE_CACHE_4BPP -DTEXTURE_CACHE_8BPP -DP_HAVE_MMAP=1 \
  -DP_HAVE_POSIX_MEMALIGN=1 -DDISABLE_MEM_LUTS=0 \
  -ffunction-sections -fdata-sections
CORE := cdriso cdrom cdrom-async cheat database decode_xa mdec misc plugins ppf \
  psxbios psxcommon psxcounters psxdma psxhw psxinterpreter psxmem psxevents \
  r3000a sio spu gpu pad gte gte_nf gte_divider
SOURCES := $(addprefix libpcsxcore/,$(addsuffix .c,$(CORE))) \
  libpcsxcore/new_dynarec/emu_if.c \
  plugins/dfsound/dma.c plugins/dfsound/freeze.c plugins/dfsound/registers.c \
  plugins/dfsound/spu.c plugins/dfsound/out.c plugins/dfsound/nullsnd.c \
  plugins/gpulib/gpu.c plugins/gpulib/vout_pl.c plugins/gpulib/prim.c \
  frontend/plugin.c frontend/mac_harness.c
ifeq ($(GPU),neon)
CFLAGS += -DGPU_NEON -DNEON_BUILD -DSIMD_BUILD
SOURCES += plugins/gpu_neon/psx_gpu_if.c plugins/gpu_neon/psx_gpu/psx_gpu_simd.c \
  frontend/mac_harness_gpu.c
else ifeq ($(GPU),vitagl-like)
SDL3_CFLAGS := $(shell pkg-config --cflags sdl3)
SDL3_LIBS := $(shell pkg-config --libs sdl3)
LIBPNG_CFLAGS := $(shell pkg-config --cflags libpng)
LIBPNG_LIBS := $(shell pkg-config --libs libpng)
# Render the Vita GL path's main target at the presentation size (HD).
VITA_GL_HD ?= 1
CFLAGS += -DCTR_NATIVE_WIDESCREEN=$(VITA_GL_HD)
CFLAGS += -DPCSX_NATIVE_VITA_PATH=1 -DGPU_VITA_CTR $(SDL3_CFLAGS) $(LIBPNG_CFLAGS) \
  -DGL_SILENCE_DEPRECATION -Iplugins/gpu_vita_ctr/include
SOURCES += plugins/gpu_vita_ctr/gpulib_if.c plugins/gpu_vita_ctr/native_gpu.c \
  plugins/gpu_vita_ctr/native_renderer.c plugins/gpu_vita_ctr/mac_vita_compat.c \
  frontend/mac_harness_gpu.c frontend/arcade_audio_mixer.c
GPU_LIBS += $(SDL3_LIBS) $(LIBPNG_LIBS) -framework OpenGL
# The interactive pause menu (arcade-shelf, its own ImGui).
SHELF_LIB := deps/arcade-shelf/build/libarcadeshelf.a
CFLAGS += -Ideps/arcade-shelf/include
PAUSE_CXXSOURCES := frontend/mac_pause.cpp frontend/shelf_options.cpp frontend/shelf_snapshot.cpp
GPU_LIBS += $(SHELF_LIB)
else
$(error Unsupported GPU '$(GPU)'; choose neon or vitagl-like)
endif
# gpulib's GPU thread (--gpu-thread), as the Vita builds use it.
GPU_THREAD ?= 0
ifeq ($(GPU_THREAD),1)
CFLAGS += -DUSE_ASYNC_GPU -Ideps/libretro-common/include
SOURCES += plugins/gpulib/gpu_async.c frontend/pcsxr-threads.c
endif
ifeq ($(DRC),1)
CFLAGS += -DBASE_ADDR_DYNAMIC
SOURCES += libpcsxcore/new_dynarec/new_dynarec.c libpcsxcore/new_dynarec/pcsxmem.c
ASM_SOURCES := libpcsxcore/new_dynarec/linkage_arm64.S \
  libpcsxcore/gte_arm64.S libpcsxcore/gte_nf_arm64.S
else
CFLAGS += -DDRC_DISABLE
endif
ifeq ($(HAVE_CHD),1)
include tools/mac-harness/libchdr.mk
CFLAGS += -DHAVE_CHD $(LIBCHDR_CFLAGS)
SOURCES += $(LIBCHDR_SOURCES)
endif
ifeq ($(BOARD),1)
ifeq ($(ARCADE_TIMING),1)
CFLAGS += -DPCSX_ARCADE_SOURCE_TIMING
endif
SOURCES += libpcsxcore/arcade/mame_zip.c libpcsxcore/arcade/system12_romset.c
SOURCES += libpcsxcore/system12.c libpcsxcore/system11.c libpcsxcore/system10.c libpcsxcore/systemzn.c libpcsxcore/systemtaito.c libpcsxcore/arcade/c352.c libpcsxcore/arcade/psx_screen_clock.c libpcsxcore/arcade/serial_nvram.c \
  libpcsxcore/arcade/namcos11_board.c libpcsxcore/arcade/at28c16.c libpcsxcore/arcade/pcm_wav.c \
  libpcsxcore/arcade/namcos10_io.c libpcsxcore/arcade/nor_flash.c \
  libpcsxcore/arcade/zn_board.c libpcsxcore/arcade/zn_mcu.c libpcsxcore/arcade/cat702.c \
  libpcsxcore/arcade/psx_sio.c libpcsxcore/arcade/capcom_zn.c \
  libpcsxcore/arcade/taito_fx1.c libpcsxcore/arcade/taito_sound_comm.c libpcsxcore/arcade/mb3773.c \
  libpcsxcore/arcade/mb89371.c libpcsxcore/arcade/i8251.c \
  libpcsxcore/arcade/eeprom93c46.c
CFLAGS += -I$(BUILD)/gnet-generated -Ilibpcsxcore/arcade/tms57002
SOURCES += libpcsxcore/arcade/zsg2.c
CXXSOURCES := libpcsxcore/arcade/gnet_zoom.cpp libpcsxcore/arcade/rf5c296.cpp \
 libpcsxcore/arcade/gnet_pccard.cpp \
 libpcsxcore/arcade/ata_storage.cpp \
 libpcsxcore/arcade/ata_mame/atahle_port.cpp \
 libpcsxcore/arcade/ata_mame/atastorage_port.cpp \
  libpcsxcore/arcade/zoom_board.cpp \
  libpcsxcore/arcade/mn10200.cpp libpcsxcore/arcade/tms57002.cpp \
  libpcsxcore/arcade/tms57002/tms57002_core.cpp libpcsxcore/arcade/tms57002/tms57kdec.cpp \
  libpcsxcore/arcade/tms57002/tmsops.cpp \
  libpcsxcore/arcade/h8.cpp libpcsxcore/arcade/h8_cycle_clock.cpp libpcsxcore/arcade/h8_adc.cpp libpcsxcore/arcade/h8_sci.cpp libpcsxcore/arcade/h8_timer16.cpp libpcsxcore/arcade/m37710.cpp \
  libpcsxcore/arcade/namcos10_crypto.cpp libpcsxcore/arcade/namcos10_board.cpp \
  libpcsxcore/arcade/z80.cpp libpcsxcore/arcade/qsound_hle.cpp \
  libpcsxcore/arcade/ym2610.cpp libpcsxcore/arcade/ymfm/ymfm_opn.cpp \
  libpcsxcore/arcade/ymfm/ymfm_ssg.cpp libpcsxcore/arcade/ymfm/ymfm_adpcm.cpp \
  libpcsxcore/arcade/ncr53cf96.cpp \
  libpcsxcore/arcade/nscsi_bus.cpp libpcsxcore/arcade/nscsi_target.cpp
ifeq ($(HAVE_CHD),1)
CFLAGS += -DPCSX_SYSTEM_GV -DPCSX_SYSTEM_GNET
SOURCES += libpcsxcore/systemgv.c libpcsxcore/systemgnet.c
CFLAGS += -DPCSX_SYSTEM12_CDXA
CXXSOURCES += libpcsxcore/arcade/sh2.cpp libpcsxcore/arcade/system12_cdxa.cpp
CXXSOURCES += libpcsxcore/arcade/konamigv.cpp libpcsxcore/arcade/nscsi_cd.cpp
CXXSOURCES += libpcsxcore/arcade/chd_hd.cpp libpcsxcore/arcade/chd_cd.cpp
CXXSOURCES += libpcsxcore/arcade/gnet_storage.cpp
endif
CFLAGS += -DPCSX_SYSTEM12
ifeq ($(SYSTEM12_TIMING),1)
CFLAGS += -DPCSX_SYSTEM12_SOURCE_TIMING
endif
endif
CXXSOURCES += $(PAUSE_CXXSOURCES)
OBJECTS := $(addprefix $(BUILD)/,$(SOURCES:.c=.o) $(CXXSOURCES:.cpp=.o) $(ASM_SOURCES:.S=.o)) $(LIBCHDR_EXTRA_OBJECTS)
GNET_TMS_HEADER := $(BUILD)/gnet-generated/tms57002.hxx
$(GNET_TMS_HEADER): libpcsxcore/arcade/tms57002/tmsinstr.lst libpcsxcore/arcade/tms57002/tmsmake.py
	@mkdir -p $(dir $@)
	python3 libpcsxcore/arcade/tms57002/tmsmake.py s $< $@
$(BUILD)/libpcsxcore/arcade/tms57002/tms57002_core.o \
$(BUILD)/libpcsxcore/arcade/tms57002/tms57kdec.o \
$(BUILD)/libpcsxcore/arcade/tms57002/tmsops.o: $(GNET_TMS_HEADER)

.PHONY: all clean smoke board-test system11-test system10-test systemgv-test tecmo-tps-test capcom-zn-test taito-fx1-test systemgnet-test gpu-type1-test devices-test FORCE
all: $(TARGET)
$(TARGET): $(OBJECTS) $(SHELF_LIB)
	$(CXX) -arch arm64 -Wl,-dead_strip -o $@ $(OBJECTS) -lz -lm $(GPU_LIBS)
# arcade-shelf has its own makefile; it rebuilds only what changed.
ifneq ($(SHELF_LIB),)
$(SHELF_LIB): FORCE
	$(MAKE) -C deps/arcade-shelf build/libarcadeshelf.a
endif
$(BUILD)/revision.h:
	@mkdir -p $(BUILD)
	@echo '#define REV "mac-harness"' > $@
$(BUILD)/compile-flags.txt: FORCE
	@mkdir -p $(BUILD)
	@printf '%s\n' '$(CC) $(CFLAGS)' > $@.tmp
	@cmp -s $@.tmp $@ || cp $@.tmp $@
	@rm -f $@.tmp
$(BUILD)/%.o: %.c $(BUILD)/revision.h $(BUILD)/compile-flags.txt
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@
# Extra flags for the H8 core alone (measurements), as in the main Makefile.
$(BUILD)/libpcsxcore/arcade/h8.o: CFLAGS += $(H8_CFLAGS)
$(BUILD)/%.o: %.cpp $(BUILD)/revision.h $(BUILD)/compile-flags.txt
	@mkdir -p $(dir $@)
	$(CXX) $(filter-out -std=gnu99,$(CFLAGS)) -std=c++17 -MMD -MP -c $< -o $@
$(BUILD)/%.o: %.S $(BUILD)/compile-flags.txt
	@mkdir -p $(dir $@)
	$(CC) $(filter-out -std=gnu99 -include stdio.h,$(CFLAGS)) -c $< -o $@
smoke: $(TARGET)
	python3 tools/mac-harness/make_smoke.py $(BUILD)/smoke.exe
	$(TARGET) --exe $(BUILD)/smoke.exe --frames 3 --output $(BUILD)/smoke.ppm --verify-smoke
gpu-type1-test: $(TARGET)
	$(TARGET) --gpu-type1-test
	$(TARGET) --gpu-type1-test-1m
board-test: $(TARGET)
	python3 tests/check_system12_harness.py --harness $(TARGET)
system11-test: $(TARGET)
	python3 tests/check_system11_harness.py --harness $(TARGET)
system10-test: $(TARGET)
	python3 tests/check_system10_harness.py --harness $(TARGET)
systemgv-test: $(TARGET)
	python3 tests/check_systemgv_harness.py --harness $(TARGET)
ifeq ($(DRC),1)
	python3 tests/check_systemgv_harness.py --harness $(TARGET) --drc
endif
tecmo-tps-test: $(TARGET)
	python3 scripts/generate_tecmo_tps_profiles.py --check
	python3 tests/check_tecmo_tps_harness.py --harness $(TARGET)
capcom-zn-test: $(TARGET)
	python3 tests/check_capcom_zn_harness.py --harness $(TARGET)
taito-fx1-test: $(TARGET)
	python3 tests/check_taito_fx1_harness.py --harness $(TARGET)
ifeq ($(DRC),1)
systemgnet-test: $(TARGET)
	python3 tests/check_systemgnet_harness.py --harness $(TARGET)
	python3 tests/check_systemgnet_harness.py --harness $(TARGET) --drc
else
systemgnet-test: $(TARGET)
	python3 tests/check_systemgnet_harness.py --harness $(TARGET)
endif
libpcsxcore/arcade/capcom_zn_profiles.inc: scripts/capcom_zn_boards.json scripts/generate_capcom_zn_profiles.py
	python3 scripts/generate_capcom_zn_profiles.py
libpcsxcore/arcade/taito_fx1_profiles.inc: scripts/taito_fx1_boards.json scripts/generate_taito_fx1_profiles.py
	python3 scripts/generate_taito_fx1_profiles.py
libpcsxcore/arcade/system11_profiles.inc: scripts/system11_boards.json scripts/generate_system11_profiles.py
	python3 scripts/generate_system11_profiles.py
libpcsxcore/arcade/system10_profiles.inc: scripts/system10_boards.json scripts/generate_system10_profiles.py
	python3 scripts/generate_system10_profiles.py
libpcsxcore/arcade/system11_inputs.inc: scripts/generate_system11_inputs.py
	python3 scripts/generate_system11_inputs.py
$(BUILD)/test-c352: tests/test_c352.c libpcsxcore/arcade/c352.c libpcsxcore/arcade/c352.h
	@mkdir -p $(BUILD)
	$(CC) -arch arm64 -O2 -std=c99 -Wall -Wextra -Werror tests/test_c352.c libpcsxcore/arcade/c352.c -o $@
$(BUILD)/test-serial: tests/test_serial_nvram.c libpcsxcore/arcade/serial_nvram.c libpcsxcore/arcade/serial_nvram.h
	@mkdir -p $(BUILD)
	$(CC) -arch arm64 -O2 -std=c99 -Wall -Wextra -Werror tests/test_serial_nvram.c libpcsxcore/arcade/serial_nvram.c -o $@
$(BUILD)/test-cat702: tests/test_cat702.c libpcsxcore/arcade/cat702.c libpcsxcore/arcade/cat702.h
	@mkdir -p $(BUILD)
	$(CC) -arch arm64 -O2 -std=c99 -Wall -Wextra -Werror tests/test_cat702.c libpcsxcore/arcade/cat702.c -o $@
$(BUILD)/test-nor-flash: tests/test_nor_flash.c libpcsxcore/arcade/nor_flash.c libpcsxcore/arcade/nor_flash.h
	@mkdir -p $(BUILD)
	$(CC) -arch arm64 -O2 -std=c99 -Wall -Wextra -Werror tests/test_nor_flash.c libpcsxcore/arcade/nor_flash.c -o $@
$(BUILD)/test-system12-jvs: tests/test_system12_jvs.c libpcsxcore/arcade/system12_jvs.h
	@mkdir -p $(BUILD)
	$(CC) -arch arm64 -O2 -std=c99 -Wall -Wextra -Werror $< -o $@
$(BUILD)/test-sh2: tests/test_sh2.cpp libpcsxcore/arcade/sh2.cpp libpcsxcore/arcade/sh2.h libpcsxcore/arcade/sh2_ops.inc
	@mkdir -p $(BUILD)
	$(CXX) -arch arm64 -O2 -std=c++17 -Wall -Wextra -Werror -Wno-unused-parameter tests/test_sh2.cpp libpcsxcore/arcade/sh2.cpp -o $@
$(BUILD)/test-gun-pointer: tests/test_gun_pointer.c frontend/gun_pointer.h
	@mkdir -p $(BUILD)
	$(CC) -arch arm64 -O2 -std=c99 -Wall -Wextra -Werror $< -o $@
ifeq ($(GPU)$(BOARD),vitagl-like1)
$(BUILD)/tests/test_mac_gun_pointer.o: tests/test_mac_gun_pointer.c frontend/mac_harness.c frontend/gun_pointer.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@
$(BUILD)/test-mac-gun-pointer: $(BUILD)/tests/test_mac_gun_pointer.o $(filter-out $(BUILD)/frontend/mac_harness.o,$(OBJECTS)) $(SHELF_LIB)
	$(CXX) -arch arm64 -Wl,-dead_strip -o $@ $(BUILD)/tests/test_mac_gun_pointer.o $(filter-out $(BUILD)/frontend/mac_harness.o,$(OBJECTS)) -lz -lm $(GPU_LIBS)
.PHONY: gun-pointer-test
gun-pointer-test: $(BUILD)/test-gun-pointer $(BUILD)/test-mac-gun-pointer
	$(BUILD)/test-gun-pointer
	$(BUILD)/test-mac-gun-pointer
else
gun-pointer-test: $(BUILD)/test-gun-pointer
	$(BUILD)/test-gun-pointer
endif
devices-test: $(BUILD)/test-nor-flash $(BUILD)/test-c352 $(BUILD)/test-serial $(BUILD)/test-cat702 $(BUILD)/test-system12-jvs $(BUILD)/test-sh2
	$(BUILD)/test-c352
	$(BUILD)/test-serial
	$(BUILD)/test-cat702
	$(BUILD)/test-nor-flash
	$(BUILD)/test-system12-jvs
	$(BUILD)/test-sh2
	$(MAKE) -f tests/Makefile.h8 BUILD=$(BUILD)/h8-tests test
	$(MAKE) -f tests/Makefile.namcos10-crypto BUILD=$(BUILD)/namcos10-tests test
	$(MAKE) -f tests/Makefile.namcos10-board BUILD=$(BUILD)/namcos10-board-tests test
	$(MAKE) -f tests/Makefile.namcos10-io BUILD=$(BUILD)/namcos10-io-tests test
	$(MAKE) -f tests/Makefile.konami-security BUILD=$(BUILD)/konami-security-tests test
	$(MAKE) -f tests/Makefile.m37710 BUILD=$(BUILD)/m37710-tests test
	$(MAKE) -f tests/Makefile.namcos11-board BUILD=$(BUILD)/namcos11-tests test
	$(MAKE) -f tests/Makefile.zn-board BUILD=$(BUILD)/zn-tests test
	$(MAKE) -f tests/Makefile.zn-mcu BUILD=$(BUILD)/zn-mcu-tests test
	$(MAKE) -f tests/Makefile.psx-sio BUILD=$(BUILD)/psx-sio-tests test
	$(MAKE) -f tests/Makefile.at28c16 BUILD=$(BUILD)/at28c16-tests test
	$(MAKE) -f tests/Makefile.z80 BUILD=$(BUILD)/z80-tests test
	$(MAKE) -f tests/Makefile.capcom-zn BUILD=$(BUILD)/capcom-zn-tests test
	$(MAKE) -f tests/Makefile.dsp16 BUILD=$(BUILD)/dsp16-tests test
	$(MAKE) -f tests/Makefile.qsound BUILD=$(BUILD)/qsound-tests test
	$(MAKE) -f tests/Makefile.qsound_hle BUILD=$(BUILD)/qsound-hle-tests test
	$(MAKE) -f tests/Makefile.taito-sound-comm BUILD=$(BUILD)/taito-sound-comm-tests test
	$(MAKE) -f tests/Makefile.ym2610 BUILD=$(BUILD)/ym2610-tests test
	$(MAKE) -f tests/Makefile.mb3773 BUILD=$(BUILD)/mb3773-tests test
	$(MAKE) -f tests/Makefile.taito-fx1 BUILD=$(BUILD)/taito-fx1-tests test
	$(MAKE) -f tests/Makefile.ncr53cf96 BUILD=$(BUILD)/ncr53cf96-tests test
	$(MAKE) -f tests/Makefile.zsg2 BUILD=$(BUILD)/zsg2-tests test
	$(MAKE) -f tests/Makefile.k056800 BUILD=$(BUILD)/k056800-tests test
	$(MAKE) -f tests/Makefile.eeprom93c46 BUILD=$(BUILD)/eeprom93c46-tests test
	$(MAKE) -f tests/Makefile.nscsi BUILD=$(BUILD)/nscsi-tests test
	$(MAKE) -f tests/Makefile.k054539 BUILD=$(BUILD)/k054539-tests test
	$(MAKE) -f tests/Makefile.i8251 BUILD=$(BUILD)/i8251-tests test
	$(MAKE) -f tests/Makefile.mb89371 BUILD=$(BUILD)/mb89371-tests test
	$(MAKE) -f tests/Makefile.nscsi-hd BUILD=$(BUILD)/nscsi-hd-tests test
	$(MAKE) -f tests/Makefile.nscsi-cd BUILD=$(BUILD)/nscsi-cd-tests test
	$(MAKE) -f tests/Makefile.m68000 BUILD=$(BUILD)/m68000-tests CXX='$(CXX)' test
	$(MAKE) -f tests/Makefile.tms57002 BUILD=$(BUILD)/tms57002-tests CXX='$(CXX)' test
ifeq ($(HAVE_CHD),1)
	$(MAKE) -f tests/Makefile.chd-hd BUILD=$(BUILD)/chd-hd-tests test
	$(MAKE) -f tests/Makefile.chd-cd BUILD=$(BUILD)/chd-cd-tests test
	$(MAKE) -f tests/Makefile.chd-scsi-hd BUILD=$(BUILD)/chd-scsi-hd-tests test
endif
	python3 -m unittest discover -s tests
clean:
	rm -rf $(BUILD)
-include $(OBJECTS:.o=.d)

$(BUILD)/test-arcade-audio-mixer: tests/test_arcade_audio_mixer.c frontend/arcade_audio_mixer.c frontend/arcade_audio_mixer.h
	@mkdir -p $(BUILD)
	$(CC) -arch arm64 -O2 -std=c99 -Wall -Wextra -Werror tests/test_arcade_audio_mixer.c frontend/arcade_audio_mixer.c -lm -o $@
ifeq ($(GPU)$(BOARD),vitagl-like1)
$(BUILD)/tests/test_mac_gnet_input.o: tests/test_mac_gnet_input.c frontend/mac_harness.c frontend/arcade_audio_mixer.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@
$(BUILD)/test-mac-gnet-input: $(BUILD)/tests/test_mac_gnet_input.o $(filter-out $(BUILD)/frontend/mac_harness.o,$(OBJECTS)) $(SHELF_LIB)
	$(CXX) -arch arm64 -Wl,-dead_strip -o $@ $(BUILD)/tests/test_mac_gnet_input.o $(filter-out $(BUILD)/frontend/mac_harness.o,$(OBJECTS)) -lz -lm $(GPU_LIBS)
.PHONY: gnet-frontend-test
gnet-frontend-test: $(BUILD)/test-arcade-audio-mixer $(BUILD)/test-mac-gnet-input
	$(BUILD)/test-arcade-audio-mixer
	$(BUILD)/test-mac-gnet-input
endif
